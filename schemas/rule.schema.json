{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carpinova.local/schemas/rule.schema.json",
  "type": "object",
  "required": ["rule_id", "page_id", "category", "subject", "predicate", "applicability", "exceptions", "sources", "status"],
  "additionalProperties": true,
  "properties": {
    "rule_id": {"$ref": "https://carpinova.local/schemas/common.schema.json#/$defs/ruleId"},
    "page_id": {"$ref": "https://carpinova.local/schemas/common.schema.json#/$defs/pageId"},
    "category": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "predicate": {"type": "string", "minLength": 1},
    "value": {},
    "unit": {"type": ["string", "null"]},
    "applicability": {"type": "object"},
    "exceptions": {"type": "array"},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "https://carpinova.local/schemas/common.schema.json#/$defs/source"}},
    "status": {"enum": ["CANDIDATE", "REVIEWED"]}
  }
}
