{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carpinova.local/schemas/batch.schema.json",
  "type": "object",
  "required": ["batch_id", "book_id", "purpose", "printed_pages", "status"],
  "additionalProperties": false,
  "properties": {
    "batch_id": {"type": "string", "pattern": "^BATCH-[A-Z0-9-]+$"},
    "book_id": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "printed_pages": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
    "status": {"enum": ["PLANNED", "IN_PROGRESS", "EXTRACTED", "REVIEWED", "ACCEPTED"]}
  }
}
