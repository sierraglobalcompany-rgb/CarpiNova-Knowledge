{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "batch_id",
    "book_id",
    "printed_pages",
    "status"
  ],
  "properties": {
    "batch_id": {
      "type": "string",
      "pattern": "^BATCH-[A-Z0-9-]+$"
    },
    "book_id": {
      "type": "string"
    },
    "printed_pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "PLANNED",
        "IN_PROGRESS",
        "ACCEPTED"
      ]
    }
  },
  "additionalProperties": true
}
