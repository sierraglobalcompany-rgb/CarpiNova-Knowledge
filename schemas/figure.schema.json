{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carpinova.local/schemas/figure.schema.json",
  "type": "object",
  "required": ["figure_id", "page_id", "type", "purpose", "source", "entities", "relationships", "measurements", "annotations", "reconstruction"],
  "additionalProperties": false,
  "$defs": {
    "normalizedPoint": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "normalizedBounds": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "fullViewport": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "x": {"const": 0},
        "y": {"const": 0},
        "width": {"const": 1},
        "height": {"const": 1}
      }
    },
    "placement": {
      "type": "object",
      "required": ["x", "y", "precision"],
      "additionalProperties": false,
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "precision": {"enum": ["exact", "approximate", "unknown"]}
      }
    }
  },
  "properties": {
    "figure_id": {"$ref": "https://carpinova.local/schemas/common.schema.json#/$defs/figureId"},
    "page_id": {"$ref": "https://carpinova.local/schemas/common.schema.json#/$defs/pageId"},
    "type": {"enum": ["technical_diagram", "dimensioned_drawing", "exploded_view", "process_diagram", "assembly_sequence", "illustration", "photo", "table", "form", "3d_reference", "mixed"]},
    "purpose": {"type": "string", "minLength": 1},
    "source": {"$ref": "https://carpinova.local/schemas/common.schema.json#/$defs/source"},
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "geometry"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {"type": "string", "minLength": 1},
          "geometry": {
            "type": "object",
            "required": ["precision"],
            "additionalProperties": true,
            "properties": {
              "primitive": {"type": ["string", "null"]},
              "precision": {"enum": ["exact", "approximate", "unknown"]},
              "dimensions": {"type": "object", "minProperties": 1}
            },
            "allOf": [
              {
                "if": {"properties": {"precision": {"const": "unknown"}}, "required": ["precision"]},
                "then": {"not": {"required": ["dimensions"]}}
              }
            ]
          }
        }
      }
    },
    "relationships": {"type": "array", "items": {"type": "object"}},
    "measurements": {"type": "array", "items": {"$ref": "https://carpinova.local/schemas/common.schema.json#/$defs/measurementId"}},
    "annotations": {"type": "array", "items": {"type": "object"}},
    "layers": {"type": "array", "items": {"type": "object"}},
    "camera": {"type": "object"},
    "visual_style": {"type": "object"},
    "educational_sequence": {"type": "array", "items": {"type": "object"}},
    "reconstruction": {
      "type": "object",
      "required": ["preferred_renderer", "deterministic_required", "generative_image_allowed"],
      "additionalProperties": false,
      "properties": {
        "preferred_renderer": {"enum": ["svg", "html", "3d", "image", "hybrid"]},
        "deterministic_required": {"type": "boolean"},
        "generative_image_allowed": {"type": "boolean"},
        "render_contract": {"enum": ["normalized-2d-v1", "semantic-table-v1", "semantic-form-v1", "semantic-sheet-v1"]}
      }
    },
    "accessibility": {"type": "object"},
    "review": {"type": "object"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reconstruction": {
            "properties": {"render_contract": {"const": "normalized-2d-v1"}},
            "required": ["render_contract"]
          }
        },
        "required": ["reconstruction"]
      },
      "then": {
        "required": ["camera", "layers"],
        "properties": {
          "camera": {
            "type": "object",
            "required": ["coordinate_space", "viewport"],
            "additionalProperties": false,
            "properties": {
              "coordinate_space": {"const": "normalized_figure"},
              "viewport": {"$ref": "#/$defs/fullViewport"}
            }
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "geometry": {
                  "oneOf": [
                    {
                      "required": ["primitive", "bounds"],
                      "properties": {
                        "primitive": {"const": "rect"},
                        "bounds": {"$ref": "#/$defs/normalizedBounds"}
                      }
                    },
                    {
                      "required": ["primitive", "points"],
                      "properties": {
                        "primitive": {"const": "line"},
                        "points": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 2,
                          "items": {"$ref": "#/$defs/normalizedPoint"}
                        }
                      }
                    },
                    {
                      "required": ["primitive", "points"],
                      "properties": {
                        "primitive": {"const": "polyline"},
                        "points": {
                          "type": "array",
                          "minItems": 2,
                          "items": {"$ref": "#/$defs/normalizedPoint"}
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "annotations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "placement": {"$ref": "#/$defs/placement"}
              }
            }
          },
          "layers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "order"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "order": {"type": "integer"},
                "entity_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}
                },
                "annotation_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}
                }
              },
              "anyOf": [
                {"required": ["entity_ids"]},
                {"required": ["annotation_ids"]}
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reconstruction": {
            "properties": {"render_contract": {"const": "semantic-table-v1"}},
            "required": ["render_contract"]
          }
        },
        "required": ["reconstruction"]
      },
      "then": {
        "properties": {
          "type": {"const": "table"},
          "reconstruction": {
            "properties": {
              "preferred_renderer": {"const": "html"},
              "deterministic_required": {"const": true},
              "generative_image_allowed": {"const": false}
            }
          },
          "entities": {
            "items": {
              "properties": {
                "type": {"enum": ["title_block", "table_title", "checklist_section", "instruction_note"]}
              },
              "allOf": [
                {
                  "if": {
                    "properties": {"type": {"enum": ["title_block", "table_title", "instruction_note"]}},
                    "required": ["type"]
                  },
                  "then": {
                    "required": ["text"],
                    "properties": {"text": {"type": "string", "pattern": "\\S"}}
                  }
                },
                {
                  "if": {
                    "properties": {"type": {"const": "checklist_section"}},
                    "required": ["type"]
                  },
                  "then": {
                    "required": ["headers", "rows"],
                    "properties": {
                      "headers": {
                        "type": "array",
                        "minItems": 1,
                        "items": {"type": "string", "minLength": 1}
                      },
                      "rows": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "items": {"type": "string"}
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reconstruction": {
            "properties": {
              "render_contract": {
                "const": "semantic-form-v1"
              }
            },
            "required": [
              "render_contract"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "type": {
            "const": "form"
          },
          "reconstruction": {
            "properties": {
              "preferred_renderer": {
                "const": "html"
              },
              "deterministic_required": {
                "const": true
              },
              "generative_image_allowed": {
                "const": false
              }
            }
          },
          "entities": {
            "minItems": 7,
            "maxItems": 7,
            "prefixItems": [
              {
                "required": [
                  "text"
                ],
                "properties": {
                  "type": {
                    "const": "title_block"
                  },
                  "text": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                }
              },
              {
                "required": [
                  "text"
                ],
                "properties": {
                  "type": {
                    "const": "form_title"
                  },
                  "text": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                }
              },
              {
                "required": [
                  "text"
                ],
                "properties": {
                  "type": {
                    "const": "brand_mark"
                  },
                  "text": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                }
              },
              {
                "required": [
                  "fields"
                ],
                "properties": {
                  "type": {
                    "const": "form_fields"
                  },
                  "fields": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "pattern": "\\S"
                    }
                  }
                }
              },
              {
                "required": [
                  "headers",
                  "rows"
                ],
                "properties": {
                  "type": {
                    "const": "checklist_table"
                  },
                  "headers": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "pattern": "\\S"
                    }
                  },
                  "rows": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              },
              {
                "required": [
                  "label"
                ],
                "properties": {
                  "type": {
                    "const": "multiline_field"
                  },
                  "label": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                }
              },
              {
                "required": [
                  "labels"
                ],
                "properties": {
                  "type": {
                    "const": "signature_lines"
                  },
                  "labels": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "pattern": "\\S"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
,
    {
      "if": {
        "properties": {
          "reconstruction": {
            "properties": {"render_contract": {"const": "semantic-sheet-v1"}},
            "required": ["render_contract"]
          }
        },
        "required": ["reconstruction"]
      },
      "then": {
        "properties": {
          "type": {"enum": ["form", "table"]},
          "reconstruction": {
            "properties": {
              "preferred_renderer": {"const": "html"},
              "deterministic_required": {"const": true},
              "generative_image_allowed": {"const": false}
            }
          },
          "entities": {
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["id", "type", "geometry"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "type": {"enum": ["sheet_title", "sheet_text", "sheet_field", "sheet_legend", "sheet_table"]},
                "geometry": {
                  "type": "object",
                  "required": ["precision"],
                  "additionalProperties": false,
                  "properties": {
                    "primitive": {"type": ["string", "null"]},
                    "precision": {"enum": ["exact", "approximate", "unknown"]}
                  }
                },
                "text": {"type": "string", "pattern": "\\S"},
                "role": {"enum": ["subtitle", "placeholder", "instruction"]},
                "label": {"type": "string", "pattern": "\\S"},
                "value": {"type": "string"},
                "entries": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["label", "code", "color"],
                    "additionalProperties": false,
                    "properties": {
                      "label": {"type": "string", "pattern": "\\S"},
                      "code": {"type": "string", "pattern": "\\S"},
                      "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
                    }
                  }
                },
                "caption": {"type": "string", "pattern": "\\S"},
                "headers": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string"}
                },
                "column_groups": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["label", "start_column", "span"],
                    "additionalProperties": false,
                    "properties": {
                      "label": {"type": "string"},
                      "start_column": {"type": "integer", "minimum": 1},
                      "span": {"type": "integer", "minimum": 1}
                    }
                  }
                },
                "sections": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["id", "heading", "rows"],
                    "additionalProperties": false,
                    "properties": {
                      "id": {"type": "string", "minLength": 1},
                      "heading": {"type": "string"},
                      "rows": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "array",
                          "items": {"type": "string"}
                        }
                      },
                      "merged_cells": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["row", "start_column", "colspan"],
                          "additionalProperties": false,
                          "properties": {
                            "row": {"type": "integer", "minimum": 0},
                            "start_column": {"type": "integer", "minimum": 0},
                            "colspan": {"type": "integer", "minimum": 2}
                          }
                        }
                      }
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": {"properties": {"type": {"const": "sheet_title"}}, "required": ["type"]},
                  "then": {"required": ["text"]}
                },
                {
                  "if": {"properties": {"type": {"const": "sheet_text"}}, "required": ["type"]},
                  "then": {"required": ["role", "text"]}
                },
                {
                  "if": {"properties": {"type": {"const": "sheet_field"}}, "required": ["type"]},
                  "then": {"required": ["label", "value"]}
                },
                {
                  "if": {"properties": {"type": {"const": "sheet_legend"}}, "required": ["type"]},
                  "then": {"required": ["entries"]}
                },
                {
                  "if": {"properties": {"type": {"const": "sheet_table"}}, "required": ["type"]},
                  "then": {"required": ["caption", "headers", "sections"]}
                }
              ],
              "oneOf": [
                {
                  "required": ["id", "type", "geometry", "text"],
                  "additionalProperties": false,
                  "properties": {"id": {}, "type": {"const": "sheet_title"}, "geometry": {}, "text": {}}
                },
                {
                  "required": ["id", "type", "geometry", "role", "text"],
                  "additionalProperties": false,
                  "properties": {"id": {}, "type": {"const": "sheet_text"}, "geometry": {}, "role": {}, "text": {}}
                },
                {
                  "required": ["id", "type", "geometry", "label", "value"],
                  "additionalProperties": false,
                  "properties": {"id": {}, "type": {"const": "sheet_field"}, "geometry": {}, "label": {}, "value": {}}
                },
                {
                  "required": ["id", "type", "geometry", "entries"],
                  "additionalProperties": false,
                  "properties": {"id": {}, "type": {"const": "sheet_legend"}, "geometry": {}, "entries": {}}
                },
                {
                  "required": ["id", "type", "geometry", "caption", "headers", "sections"],
                  "additionalProperties": false,
                  "properties": {"id": {}, "type": {"const": "sheet_table"}, "geometry": {}, "caption": {}, "headers": {}, "column_groups": {}, "sections": {}}
                }
              ]
            }
          }
        }
      }
    }  ]
}
