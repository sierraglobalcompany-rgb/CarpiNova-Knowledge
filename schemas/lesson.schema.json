{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "content_refs",
    "figure_refs",
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^LESSON-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string"
    },
    "content_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "figure_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
